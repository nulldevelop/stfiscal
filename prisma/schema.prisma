// ===============================================
// 10. CADASTROS AUXILIARES E LOGS
// ===============================================

model Lotacoes {
  id             String       @id @default(uuid())
  name           String       @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("lotacao")
}

model TipoRelatorio {
  id             String       @id @default(uuid())
  name           String       @unique
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  validade       Int
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@map("tipo_relatorio")
}

model AuditLog {
  id             String       @id @default(uuid())
  action         LogAction
  entity         String       @db.Text
  entityId       String?      @db.Text
  entityName     String?      @db.Text
  userId         String       @db.Text
  userName       String       @db.Text
  userEmail      String       @db.Text
  organizationId String
  description    String?      @db.Text
  before         String?      @db.LongText
  after          String?      @db.LongText
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("audit_log")
}

model ApiSyncLog {
  id             String   @id @default(uuid())
  organizationId String
  status         String // "success" | "error"
  totalContratos Int?
  totalFiscais   Int?
  message        String?  @db.Text
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("api_sync_log")
}

model SystemUpdate {
  id             String       @id @default(cuid())
  title          String       @db.Text
  description    String       @db.LongText
  version        String?      @db.VarChar(20)
  isActive       Boolean      @default(true)
  targetRoles    String?      @db.Text
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("system_update")
}

model FormConfig {
  id                 String       @id @default(cuid())
  reportType         String // "BENS_SERVICOS", "TRANSPORTE", "OBRAS"
  fieldKey           String // Nome técnico
  label              String       @db.Text
  description        String?      @db.Text
  type               String
  options            String?      @db.TinyText
  isRequired         Boolean      @default(false)
  isVisiblePrincipal Boolean      @default(true)
  isVisibleSetorial  Boolean      @default(true)
  order              Int          @default(0)
  section            String?      @db.Text
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  isActive           Boolean      @default(true)
  isLongText         Boolean      @default(false)
  hasObs             Boolean      @default(false)
  requiredObsValue   String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([reportType, fieldKey, organizationId])
  @@index([organizationId])
  @@map("form_config")
}
