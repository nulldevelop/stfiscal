  recebeuNotificacao                              String
  recebeuNotificacaoObs                           String?        @db.Text
  aberturaProcessoAdministrativo                  String?        @db.Text
  aberturaProcessoAdministrativoObs               String?        @db.Text
  sofreuSancao                                    String?
  sofreuSancaoObs                                 String?        @db.Text

  // 6 - SUBCONTRATAÇÃO
