<configuration>
  <system.webServer>

    <!-- IISNode handler -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <!-- Reescrita de URL -->
    <rewrite>
      <rules>

        <!-- NÃO reescreve arquivos e pastas reais (images, css, js, etc) -->
        <rule name="StaticContent" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- Tudo que não for arquivo físico vai pro Next -->
        <rule name="NextJS" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>

      </rules>
    </rewrite>

    <!-- Configuração do IISNode -->
    <iisnode
      node_env="production"
      nodeProcessCommandLine="&quot;C:\Program Files\nodejs\node.exe&quot;"
      interceptor="&quot;%programfiles%\iisnode\interceptor.js&quot;"
      loggingEnabled="true"
      devErrorsEnabled="false"
      flushResponse="true"
    />

    <!-- Cache estático (melhora performance) -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge"
                   cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <!-- Compressão (melhora velocidade) -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- Erros personalizados -->
    <httpErrors errorMode="Custom" existingResponse="Replace">

      <remove statusCode="404"/>
      <remove statusCode="500"/>
      <remove statusCode="401"/>
      <remove statusCode="403"/>

      <error statusCode="404" path="/erros/404.html" responseMode="File" />
      <error statusCode="500" path="/erros/500.html" responseMode="File" />
      <error statusCode="401" path="/erros/401.html" responseMode="File" />
      <error statusCode="403" path="/erros/403.html" responseMode="File" />

    </httpErrors>

  </system.webServer>
</configuration>
